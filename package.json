{
  "name": "skill-shelf-magpie-plugin",
  "version": "0.1.15",
  "description": "Discover, install and organize Skills, manage Agent access and sync independent Packs in Magpie.",
  "type": "module",
  "main": "./dist/plugin.mjs",
  "exports": {
    ".": "./dist/plugin.mjs",
    "./server": "./dist/plugin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "FEATURE_PARITY.md",
    "LICENSE"
  ],
  "license": "MIT",
  "keywords": [
    "magpie-plugin",
    "opencode-plugin",
    "skills",
    "skill-shelf",
    "packs"
  ],
  "engines": {
    "node": ">=22"
  },
